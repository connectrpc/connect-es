{
  "name": "@connectrpc/connect-conformance",
  "version": "2.3.0",
  "private": true,
  "conformanceVersion": "v1.0.7",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "bin": {
    "connectconformance": "bin/connectconformance.cjs"
  },
  "scripts": {
    "generate": "buf generate 'https://github.com/jonbodner-buf/conformance.git#ref=9cfc2758fd5482abe880470039760c0cbe87a7bb,subdir=proto'",
    "postgenerate": "license-header src/gen",
    "prebuild": "rm -rf ./dist/*",
    "build": "npm run build:cjs && npm run build:esm",
    "postbuild": "connectconformance --version",
    "build:cjs": "tsc --project tsconfig.json --module commonjs --verbatimModuleSyntax false --moduleResolution node10 --ignoreDeprecations 6.0 --outDir ./dist/cjs && echo >./dist/cjs/package.json '{\"type\":\"commonjs\"}'",
    "build:esm": "tsc --project tsconfig.json --outDir ./dist/esm",
    "format": "biome format --write",
    "license-header": "license-header",
    "lint": "biome lint --error-on-warnings",
    "attw": "attw --pack"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.7.0",
    "@connectrpc/connect": "2.3.0",
    "fflate": "^0.8.3",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14"
  }
}
