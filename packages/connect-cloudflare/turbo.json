{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "outputs": ["conformance/gen/**"]
    },
    "conformance:client": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["CLOUDFLARE_*"]
    },
    "conformance:server": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["CLOUDFLARE_*"]
    }
  }
}
