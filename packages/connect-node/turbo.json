{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "outputs": ["src/testdata/gen/**"]
    },
    "conformance": {
      "dependsOn": ["conformance:client", "conformance:server"]
    },
    "conformance:client": { "cache": false, "dependsOn": ["^build"] },
    "conformance:server": { "cache": false, "dependsOn": ["^build"] }
  }
}
